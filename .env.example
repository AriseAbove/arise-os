# ARISE OS — copy to .env.local and fill in. .env.local is gitignored.

# ── Email (up to 4 IMAP inboxes) ─────────────────────────────────────────
# Gmail: use an App Password (Google Account → Security → 2FA → App passwords)
# Also powers Website Pulse (lib/connectors/website-leads.ts) — reads
# FormSubmit.co form-notification emails from whichever inbox they land in.
# No separate credential needed; set this once and both connectors go live.
INBOX_1_HOST=imap.gmail.com
INBOX_1_USER=
INBOX_1_PASS=
INBOX_1_NAME=
# INBOX_1_PORT=993            # optional, defaults to 993
INBOX_2_HOST=
INBOX_2_USER=
INBOX_2_PASS=
INBOX_3_HOST=
INBOX_3_USER=
INBOX_3_PASS=
INBOX_4_HOST=
INBOX_4_USER=
INBOX_4_PASS=

# ── Calendar (ICS/CalDAV, e.g. Google) ───────────────────────────────────
# Google: same App Password mechanism as IMAP
CAL_1_USER=
CAL_1_PASS=
CAL_1_NAME=
CAL_1_COLOR=

# ── Comms lane routing (/comms Work/Personal/Misc split) ─────────────────
# Comma-separated terms that route a message into the Work lane, on top of
# the brand-free defaults in lib/comms-gravity.ts (invoice, contract, …).
# The operator's real client/vendor/sub names belong HERE, in .env.local —
# never in this committed example file (see the comment in comms-gravity.ts).
COMMS_WORK_KEYWORDS=

# ── QuickBooks (the real books) ──────────────────────────────────────────
# Intuit developer app keys; authorize at /api/connections/quickbooks/connect
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENVIRONMENT=sandbox   # production is the default; set sandbox only for dev keys / local testing

# ── Allo (AI receptionist call log → funnel) ─────────────────────────────
# Allo web → settings → API → Create API key (Conversations Read scope).
ALLO_API_KEY=

# ── OneUp (social publish + reviews) ──────────────────────────────────────
# ONEUP_API_KEY is normally set via /integrations (Marketing → OneUp), never
# pasted here. ONEUP_CATEGORY_ID has no UI yet — find it by calling
# GET https://www.oneupapp.io/api/listcategory?apiKey=YOUR_KEY in a browser
# (see docs/oneup-integration.md) and copying the id next to the category
# your accounts are grouped under.
# ONEUP_API_KEY=
# ONEUP_CATEGORY_ID=

# ── LLM (agent chat) ─────────────────────────────────────────────────────
# Routed through the Vercel AI Gateway (works from any host, not just
# Vercel) — pay-as-you-go, zero markup over the model's own per-token price.
AI_GATEWAY_API_KEY=
# LLM_PROVIDER=stub           # tests / offline

# ── Knowledge store ──────────────────────────────────────────────────────
# Point at any folder of markdown files; search + capture work locally.
BRAIN_STORE=
# BRAIN_PROVIDER=stub         # tests / offline

# ── Chief of Staff (proactive signal engine + push) ──────────────────────
# ntfy.sh topic for push notifications — pick any hard-to-guess topic name
# (anyone who knows it can read your pushes). Self-host via NTFY_URL instead
# of ntfy.sh if you want the topic name itself kept private.
NTFY_TOPIC=
# NTFY_URL=https://ntfy.example.com   # optional, defaults to https://ntfy.sh
# Shared secret every agent's scheduled check
# (.github/workflows/chief-of-staff-check.yml and
# .github/workflows/agent-cron-checks.yml — one route per real agent, see
# app/api/cron/[agentId]/route.ts) sends as "Authorization: Bearer
# $CRON_SECRET" — set the same value here and as a GitHub Actions repo
# secret. Long, random string; not a real password.
CRON_SECRET=

# ── Voice relay (Zoey speaker daemon) ─────────────────────────────────────
# Shared secret for POST/GET /api/voice/queue — Claude enqueues a short
# reply, ~/.cowork_speaker/speaker_daemon.py on Sean's Mac polls it and
# reads it aloud, with no device-folder grant needed. Set the same value
# here, as a Railway env var, and in speaker_daemon.py's config.
VOICE_RELAY_SECRET=

# ── AAC Brain health relay ─────────────────────────────────────────────────
# Shared secret for POST/GET /api/aac-brain — ~/.aac_brain/stateio.py's
# heartbeat() on Sean's Mac pushes a snapshot of the AAC Brain's own health
# (pending drafted actions, failing workers) here every time it already
# pings its Healthchecks canary. The dashboard tile and /aac-brain page read
# it back. Set the same value here, as a Railway env var, and in
# ~/.aac_brain/.env as AAC_BRAIN_SECRET (see brain_health_push.py). Also set
# AAC_BRAIN_URL in ~/.aac_brain/.env to this app's own base URL
# (e.g. https://<your-railway-domain>) — that one lives on the Mac, not here.
AAC_BRAIN_SECRET=

# ── Push relay (Chief of Staff ntfy fallback) ─────────────────────────────
# Shared secret for GET /api/push/relay. 2026-08-24: live diagnosis from
# Railway's own Console confirmed this service cannot reach ntfy.sh's IP at
# all (general outbound HTTPS works fine — connecting to ntfy.sh specifically
# times out, most likely ntfy.sh blocking Railway's shared egress IPs), so
# lib/agents/real.ts's chiefOfStaffRunWith queues a failed push here instead
# of just recording the failure. ~/.aac_brain/push_relay.py on Sean's Mac
# (which reaches ntfy.sh fine) polls this route and forwards the push. Set
# the same value here, as a Railway env var, and in ~/.aac_brain/.env as
# PUSH_RELAY_SECRET. Reuses the existing AAC_BRAIN_URL already set in
# ~/.aac_brain/.env for the app's base URL (see the AAC Brain health relay
# section above) rather than asking Sean to configure a second URL for the
# same app.
PUSH_RELAY_SECRET=

# ── App-wide login (Basic Auth wall) ──────────────────────────────────────
# 2026-08-15 security review: every page and ~40 of ~42 API routes were
# reachable by anyone who had the URL — no password at all. middleware.ts
# now gates the whole app behind HTTP Basic Auth once BOTH of these are
# set (it fails OPEN — no protection — if either is blank, matching this
# repo's honest-by-default pattern). The cron, voice-relay, and push-relay
# routes are exempt; they authenticate themselves via CRON_SECRET /
# VOICE_RELAY_SECRET / AAC_BRAIN_SECRET / PUSH_RELAY_SECRET.
# Set both here and as Railway env vars.
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASS=

# ── Database ─────────────────────────────────────────────────────────────
# Production (Railway): point at a path inside the mounted volume.
# FOUNDER_OS_DB=/data/founder-os.db

# ── Statement ledger (uploaded bank/CC statement data) ────────────────────
# A SEPARATE better-sqlite3 store from the main DB above (lib/ledger.ts) —
# holds every row imported from a /finances statement upload. Same ephemeral-
# filesystem risk as FOUNDER_OS_DB: without this set, uploaded statement data
# lives at ./data/ledger.db and is silently wiped on every Railway redeploy.
# Production (Railway): point at a path inside the mounted volume.
# LEDGER_DB=/data/ledger.db

# ── Connector credentials overlay (.env.local) ────────────────────────────
# lib/creds.ts reads/writes a live .env.local overlay so a key pasted into
# the Connections board's connect flow (or a rotated QuickBooks token) takes
# effect without a restart — see lib/creds.ts's header comment. By default
# this file lives at ./.env.local (process.cwd()), which is fine for local
# dev but is regular ephemeral-container disk on Railway: any credential
# saved through /integrations or /keys would vanish on the next redeploy.
# Production (Railway): point at a path inside the mounted volume.
# FOUNDER_OS_ENV_LOCAL=/data/.env.local
